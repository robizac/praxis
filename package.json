{
  "name": "praxis-app",
  "version": "1.0.0",
  "description": "PRAXIS - transformar conhecimento em ação prática",
  "main": "src/http/server.js",
  "scripts": {
    "dev": "nodemon src/http/server.js",
    "start": "node src/http/server.js",
    "migrate": "node scripts/migrate.js",
    "migrate:legacy": "node scripts/migrate-legacy.js",
    "stripe:setup": "node scripts/stripe-setup.js",
    "worker": "node src/jobs/reminders.worker.js",
    "test": "node --test",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "sqlite3": "^5.1.7",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10"
  }
}
