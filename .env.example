# ==============================================================================
# PRAXIS — variáveis de ambiente
# Copie para .env e preencha. NUNCA comite o .env.
# Referência completa: docs/13-deploy-kymus.md
# ==============================================================================

# ------------------------------------------------------------------------------
# App / servidor
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
APP_BASE_DOMAIN=localhost
SESSION_SECRET=                        # 32+ bytes aleatórios (obrigatório em produção)
                                       # gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATABASE_URL=                          # ex.: postgres://user:pass@host:5432/praxis
                                       # (vazio => usa SQLite local em dev, ver db.js)

# ------------------------------------------------------------------------------
# IA — provider gerenciado (chave da plataforma, usada com cota por plano)
# ------------------------------------------------------------------------------
AI_PROVIDER=ollama                     # dev: ollama | openai | anthropic | gemini
                                       # (em produção só remoto: openai | anthropic | gemini)
AI_DEFAULT_PROVIDER=openai             # provider gerenciado do produto
MANAGED_OPENAI_API_KEY=                # chaves da plataforma (modo gerenciado)
MANAGED_ANTHROPIC_API_KEY=
MANAGED_GEMINI_API_KEY=
AI_DEFAULT_MODEL=gpt-5-nano            # modelo econômico padrão
AI_MAX_TOKENS=400
AI_TIMEOUT_MS=20000
AI_DAILY_BUDGET_USD=5                  # teto de custo diário agregado (modo gerenciado)
AI_KEY_ENCRYPTION_SECRET=              # 32+ bytes: cifra das chaves BYOK (AES-256-GCM)

# ------------------------------------------------------------------------------
# IA — chaves diretas (legado / dev / BYOK via env)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# IA — Ollama local (dev, custo zero)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

#--------------------------------------------------------------------------------
# E-mail transacional (verificação, reset, cobrança, lembretes)
# ------------------------------------------------------------------------------
EMAIL_PROVIDER=                        # ex.: resend | ses | smtp
EMAIL_API_KEY=
EMAIL_FROM="PRAXIS <no-reply@localhost>"

# ------------------------------------------------------------------------------
# Stripe (assinaturas) — gere os preços com: npm run stripe:setup
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=                     # sk_test_... (teste) ou sk_live_...
STRIPE_WEBHOOK_SECRET=                 # whsec_... (endpoint /webhooks/stripe)
STRIPE_PRICE_PRO_MONTHLY=              # price_... (Pro mensal)
STRIPE_PRICE_PRO_ANNUAL=               # price_... (Pro anual)
STRIPE_PORTAL_CONFIG_ID=               # opcional: configuração do Billing Portal
BILLING_TRIAL_DAYS=7                   # trial do Pro em dias

# ------------------------------------------------------------------------------
# Telegram (lembretes) — por usuário no produto; estas ficam para dev/legado
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=                      # opcional: destino global (dev/legado)
TELEGRAM_BOT_USERNAME=                 # ex.: praxis_bot (mostrado ao parear)
TELEGRAM_WEBHOOK_SECRET=               # valida o header X-Telegram-Bot-Api-Secret-Token
