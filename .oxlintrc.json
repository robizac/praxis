{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "node"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "caughtErrorsIgnorePattern": "^_" }]
  },
  "ignorePatterns": ["node_modules", "web/**", ".opencode/**"]
}
