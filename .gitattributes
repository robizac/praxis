# Normaliza as quebras de linha: sem isso o mesmo arquivo aparece como
# "modificado" em máquinas diferentes (CRLF no Windows x LF no Linux) e gera
# diffs falsos no PR.
* text=auto eol=lf

# Binários
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary
*.sqlite binary
*.sqlite3 binary
*.db binary
